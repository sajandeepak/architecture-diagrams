        <mxCell id="GyV2wykm-IdrSrDU3RWV-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;u&gt;Benefits&lt;/u&gt;&lt;/b&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Ideal Architecture for migrating exiting op-premises workload to cloud without mordanization&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
